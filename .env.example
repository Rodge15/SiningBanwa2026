# Copy this file to .env.local and replace the placeholders.
# .env.local stays on your computer and must not be committed.

# Project URL from Supabase: Project Settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# anon public key from Supabase: Project Settings -> API Keys
# This key is safe to use in browser code. It is not the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# service_role key from the same API Keys page.
# Server only. Never put this key in a client component or a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
